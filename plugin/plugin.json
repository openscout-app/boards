{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "scout-boards",
  "version": "0.2.0",
  "description": "Scout's Kanban and the Vercel Board rooms it follows, in the thread. Open a card, move it, review a move or claim work, with a link to the full page.",
  "author": {
    "name": "OpenScout",
    "url": "https://openscout.app"
  },
  "homepage": "https://openscout.app",
  "repository": "https://github.com/openscout-app/boards",
  "keywords": ["openscout", "kanban", "work-board", "mcp-apps"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Scout boards",
        "shortDescription": "Scout's work board in the thread",
        "developerName": "OpenScout",
        "category": "Productivity",
        "capabilities": ["Interactive"],
        "websiteURL": "https://openscout.app",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "defaultPrompt": [
          "Show me the work board.",
          "What's waiting on review?",
          "Show me the board room."
        ]
      }
    },
    "ai.capy": {
      "displayName": "Scout boards",
      "icon": "./assets/icon.png"
    }
  }
}
