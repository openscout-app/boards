{
  "name": "@openscout/boards",
  "version": "0.3.0",
  "description": "Scout's work as a Kanban, beside the Vercel Board rooms Scout follows. Prebuilt HTML served on loopback and backed by the Scout CLI.",
  "license": "Apache-2.0",
  "homepage": "https://openscout.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openscout-app/boards.git"
  },
  "bugs": "https://github.com/openscout-app/boards/issues",
  "type": "module",
  "bin": {
    "scout-boards": "bin/boards.mjs"
  },
  "files": [
    "bin",
    "server/*.mjs",
    "!server/*.test.mjs",
    "dist",
    "plugin",
    "extension",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode view",
    "start": "node bin/boards.mjs",
    "test": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "@openscout/scout": "^0.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^4.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "scout-app": "github:openscout-app/scout-app#b4d8686",
    "vite": "^7.0.0"
  }
}
